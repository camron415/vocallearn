# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# harvest filmstrips written by the local capture sink
/captures/

# harvest Q&A dumps (full asks) — local tuning only
/reports/harvest-turns-*.json
/reports/harvest-turns-latest.md

# lab bucket-smoke credentials (never Camron's account)
.smoke-user.json

# typescript
*.tsbuildinfo
next-env.d.ts

# macOS Finder duplicate copies
* 2.ts
* 2.mjs
* 2.tsx
