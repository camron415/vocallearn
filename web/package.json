{
  "name": "halo-web",
  "description": "Halo — invite-only family Ask chat with Cove/Keep learning loop (Next.js, TypeScript, Supabase, Grok).",
  "version": "1.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:lan": "node scripts/dev-lan.mjs",
    "preview": "node scripts/preview-up.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:harvest": "tsx src/lib/v2-lib-check.ts",
    "test:harvest:live": "tsx --env-file=.env.local src/lib/harvest-smoke-live.ts",
    "test:harvest:live:dry": "tsx src/lib/harvest-smoke-live.ts --dry",
    "test:harvest:family": "tsx --env-file=.env.local src/lib/harvest-family-review-run.ts",
    "test:harvest:family:dry": "tsx src/lib/harvest-family-review-run.ts --dry",
    "test:ask:harness": "tsx src/lib/ask-harness-run.ts",
    "test:ask:claims": "tsx src/lib/ask-claim-harness-check.ts",
    "test:ask:buckets": "tsx --env-file=.env.local src/lib/ask-bucket-smoke.ts",
    "test:ask:harness:live": "tsx --env-file=.env.local src/lib/ask-bucket-smoke.ts",
    "harvest:export": "tsx --env-file=.env.local scripts/harvest-export.mjs",
    "deploy:lab": "vercel deploy --yes",
    "deploy:early": "vercel deploy --prod --yes",
    "capture:sink": "node scripts/harvest-sink.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.2",
    "framer-motion": "^13.1.0",
    "html-to-image": "^1.11.13",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "tsx": "^4.20.5",
    "typescript": "^5"
  }
}
